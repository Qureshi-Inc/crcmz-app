<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key><string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.crcmz.me</string>
		<string>webcredentials:app.crcmz.me</string>
		<!-- Passkeys belong to crcmz.me (new) or auth.crcmz.me (older): both say this app may use them. -->
		<string>webcredentials:crcmz.me</string>
		<string>webcredentials:auth.crcmz.me</string>
	</array>
	<!-- The session, for the share extension (SharedSession.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)me.crcmz.shared</string>
	</array>
</dict>
</plist>
