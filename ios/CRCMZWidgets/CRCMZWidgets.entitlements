<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's session (SharedSession.swift), to fetch what the widgets show as you. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)me.crcmz.shared</string>
	</array>
</dict>
</plist>
