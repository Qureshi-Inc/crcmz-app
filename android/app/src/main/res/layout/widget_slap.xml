<?xml version="1.0" encoding="utf-8"?>
<!-- Slap player widget (Widgets.kt, SlapWidget): what's playing, with play / pause, previous and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/slap_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <ImageView android:id="@+id/slap_art" android:layout_width="64dp" android:layout_height="64dp"
        android:scaleType="centerCrop" android:src="@drawable/widget_poster_blank" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/slap_head" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_slap_head" android:textColor="#FFFF2FD6" android:textSize="11sp" android:textStyle="bold"
            android:letterSpacing="0.1" android:maxLines="1" />
        <TextView android:id="@+id/slap_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#FFF3ECFF" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/slap_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF9D8FC4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="6dp" android:gravity="center_vertical">
            <ImageView android:id="@+id/slap_prev" android:layout_width="36dp" android:layout_height="36dp" android:padding="7dp"
                android:src="@drawable/ic_prev" android:contentDescription="@string/widget_slap_prev" />
            <ImageView android:id="@+id/slap_play" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                android:src="@drawable/ic_play" android:background="@drawable/widget_play_bg" android:contentDescription="@string/widget_slap_play" />
            <ImageView android:id="@+id/slap_next" android:layout_width="36dp" android:layout_height="36dp" android:padding="7dp"
                android:src="@drawable/ic_next" android:contentDescription="@string/widget_slap_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
